# Variables de entorno del frontend.
#
# Copiar a `.env.local` y ajustar. Sin ninguna de ellas la aplicacion arranca
# contra el mock, que guarda los datos en el navegador: es el modo de trabajo
# mientras el backend no exista.
#
# Ver docs/14 §2.3 para el procedimiento completo de conexion a la API real.

# Raiz de la API. Relativa o absoluta.
#   /api                          por defecto
#   http://localhost:8080/api     backend en local
#   https://api.contikos.cr/v1    despliegue
#
# Declararla apaga el mock por si sola: si se dice donde esta la API, es que se
# quiere hablar con ella.
# VITE_API_URL=http://localhost:8080/api

# Fuerza el origen de los datos y gana sobre lo anterior.
#   true    el mock, aunque VITE_API_URL este declarada
#   false   la API, aunque VITE_API_URL no lo este
# VITE_USAR_MOCKS=false

# Tiempo maximo por peticion, en milisegundos. Por defecto 15000.
# Agotarlo produce un error TIEMPO_AGOTADO, que la aplicacion reintenta.
# VITE_API_TIMEOUT_MS=15000
